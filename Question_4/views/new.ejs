<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Q4 - Add New Employee</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 30px; }
        table { border-collapse: collapse; width: 620px; }
        td { padding: 8px; vertical-align: top; }
        input[type="text"], input[type="email"], input[type="number"], select { width: 92%; padding: 6px; }
        .alert-error { background-color: #ffebee; border: 1px solid #d32f2f; color: #d32f2f; padding: 10px; margin-bottom: 15px; width: 600px; }
        .btn-submit { background-color: #28a745; color: white; padding: 8px 16px; border: none; cursor: pointer; border-radius: 3px; }
        .btn-cancel { color: #666; text-decoration: none; margin-left: 10px; }
    </style>
</head>
<body>

    <h2>Add New Employee (ERP System)</h2>
    <p>Fill out the employee information below. Password will be encrypted with Bcrypt and emailed via Nodemailer upon saving.</p>

    <% if (error) { %>
        <div class="alert-error"><%= error %></div>
    <% } %>

    <form action="/employees/new" method="POST">
        <table border="1">
            <tr>
                <td><label for="empid"><strong>Generated Employee ID:</strong></label></td>
                <td>
                    <input type="text" id="empid" name="empid" value="<%= suggestedEmpId %>" readonly style="background-color: #f0f0f0;">
                </td>
            </tr>
            <tr>
                <td><label for="password"><strong>Auto-Generated Password:</strong></label></td>
                <td>
                    <input type="text" id="password" name="password" value="<%= suggestedPassword %>" required>
                    <br><small style="color: #666;">Will be encrypted using bcrypt before database insertion and emailed to user.</small>
                </td>
            </tr>
            <tr>
                <td><label for="name">Employee Full Name:</label></td>
                <td><input type="text" id="name" name="name" placeholder="e.g. Rahul Sharma" required></td>
            </tr>
            <tr>
                <td><label for="email">Employee Email:</label></td>
                <td><input type="email" id="email" name="email" placeholder="e.g. rahul@company.com" required></td>
            </tr>
            <tr>
                <td><label for="department">Department:</label></td>
                <td>
                    <select id="department" name="department" required>
                        <option value="">-- Select Department --</option>
                        <option value="Information Technology">Information Technology</option>
                        <option value="Human Resources">Human Resources</option>
                        <option value="Finance">Finance</option>
                        <option value="Marketing">Marketing</option>
                    </select>
                </td>
            </tr>
            <tr>
                <td><label for="designation">Designation:</label></td>
                <td><input type="text" id="designation" name="designation" placeholder="e.g. Fullstack Developer" required></td>
            </tr>
            <tr>
                <td><label for="basicSalary">Basic Salary ($):</label></td>
                <td><input type="number" id="basicSalary" name="basicSalary" value="50000" min="0" oninput="updateNetSalary()" required></td>
            </tr>
            <tr>
                <td><label for="allowances">Allowances ($):</label></td>
                <td><input type="number" id="allowances" name="allowances" value="10000" min="0" oninput="updateNetSalary()" required></td>
            </tr>
            <tr>
                <td><label for="deductions">Deductions ($):</label></td>
                <td><input type="number" id="deductions" name="deductions" value="5000" min="0" oninput="updateNetSalary()" required></td>
            </tr>
            <tr>
                <td><strong>Calculated Net Salary:</strong></td>
                <td>
                    <span id="previewNetSalary" style="font-weight: bold; font-size: 16px; color: #2e7d32;">$55000</span>
                    <br><small>(Formula: Basic + Allowances - Deductions)</small>
                </td>
            </tr>
            <tr>
                <td colspan="2" align="center">
                    <button type="submit" class="btn-submit">Save Employee & Send Email</button>
                    <a href="/employees" class="btn-cancel">Cancel</a>
                </td>
            </tr>
        </table>
    </form>

    <script>
        function updateNetSalary() {
            const basic = parseFloat(document.getElementById('basicSalary').value) || 0;
            const allow = parseFloat(document.getElementById('allowances').value) || 0;
            const deduct = parseFloat(document.getElementById('deductions').value) || 0;
            const net = basic + allow - deduct;
            document.getElementById('previewNetSalary').innerText = '$' + net;
        }
    </script>

</body>
</html>
