<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Q4 - ERP Admin Panel: Employees</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 30px; }
        .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        table { border-collapse: collapse; width: 100%; margin-top: 15px; }
        th, td { padding: 8px 10px; text-align: left; }
        th { background-color: #f2f2f2; }
        .success-box { background-color: #e8f5e9; border: 1px solid #4caf50; color: #2e7d32; padding: 10px; margin-bottom: 15px; }
        .btn-add { background-color: #28a745; color: white; padding: 7px 14px; text-decoration: none; border-radius: 4px; font-weight: bold; }
        .btn-edit { background-color: #007bff; color: white; padding: 4px 8px; text-decoration: none; border-radius: 3px; font-size: 13px; }
        .btn-delete { background-color: #dc3545; color: white; padding: 4px 8px; text-decoration: none; border-radius: 3px; font-size: 13px; }
        .btn-logout { background-color: #6c757d; color: white; padding: 6px 12px; text-decoration: none; border-radius: 4px; }
        .badge { background: #e0f2fe; color: #0284c7; padding: 2px 6px; border-radius: 4px; font-weight: bold; }
    </style>
</head>
<body>

    <div class="top-bar">
        <h2>ERP System - Admin Panel (Employees Management)</h2>
        <div>
            <a href="/employees/new" class="btn-add">+ Add New Employee</a>
            &nbsp;&nbsp;
            <a href="/logout" class="btn-logout">Logout</a>
        </div>
    </div>

    <% if (flashMessage) { %>
        <div class="success-box">
            <%= flashMessage %>
            <% if (emailLink) { %>
                <br><strong>Nodemailer Sent Email:</strong> 
                <a href="<%= emailLink %>" target="_blank" style="color: #1565c0; text-decoration: underline;">
                    Click here to view the simulated sent email on Ethereal
                </a>
            <% } %>
        </div>
    <% } %>

    <h3>Employee Records (Mongoose & Net Salary Calculation)</h3>
    <p><em>Formula: Net Salary = Basic Salary + Allowances - Deductions</em></p>

    <table border="1">
        <thead>
            <tr>
                <th>Emp ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Department</th>
                <th>Designation</th>
                <th>Basic Salary</th>
                <th>Allowances</th>
                <th>Deductions</th>
                <th>Net Salary</th>
                <th>Password Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (employees && employees.length > 0) { %>
                <% employees.forEach(function(emp) { %>
                    <tr>
                        <td><span class="badge"><%= emp.empid %></span></td>
                        <td><%= emp.name %></td>
                        <td><%= emp.email %></td>
                        <td><%= emp.department %></td>
                        <td><%= emp.designation %></td>
                        <td>$<%= emp.basicSalary %></td>
                        <td>$<%= emp.allowances %></td>
                        <td>$<%= emp.deductions %></td>
                        <td><strong>$<%= emp.netSalary %></strong></td>
                        <td><small title="<%= emp.password %>">Bcrypt Encrypted</small></td>
                        <td>
                            <a href="/employees/edit/<%= emp._id %>" class="btn-edit">Edit</a>
                            &nbsp;
                            <a href="/employees/delete/<%= emp._id %>" class="btn-delete" onclick="return confirm('Are you sure you want to delete this employee?');">Delete</a>
                        </td>
                    </tr>
                <% }); %>
            <% } else { %>
                <tr>
                    <td colspan="11" align="center">No employees found. Click "+ Add New Employee" above to insert one.</td>
                </tr>
            <% } %>
        </tbody>
    </table>

</body>
</html>
