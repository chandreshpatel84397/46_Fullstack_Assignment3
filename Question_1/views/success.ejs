<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Q1 - Registration Successful</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 30px; }
        table { border-collapse: collapse; width: 650px; margin-top: 15px; }
        th, td { padding: 10px; text-align: left; }
        th { background-color: #f2f2f2; width: 35%; }
        img.thumb { width: 100px; height: 100px; object-fit: cover; border: 1px solid #ccc; display: block; margin-bottom: 5px; }
        .gallery { display: flex; flex-wrap: wrap; gap: 15px; }
        .pic-card { border: 1px solid #ddd; padding: 6px; text-align: center; }
        .download-btn { display: inline-block; padding: 4px 8px; background-color: #007bff; color: white; text-decoration: none; font-size: 13px; border-radius: 3px; }
        .download-btn:hover { background-color: #0056b3; }
        .btn-back { display: inline-block; margin-top: 20px; padding: 8px 16px; background-color: #28a745; color: white; text-decoration: none; border-radius: 4px; }
    </style>
</head>
<body>

    <h2>Registration Details (Tabular View)</h2>
    <p style="color: green;"><strong>Success!</strong> The user has been registered successfully.</p>

    <table border="1">
        <tr>
            <th>Username</th>
            <td><%= user.username %></td>
        </tr>
        <tr>
            <th>Email</th>
            <td><%= user.email %></td>
        </tr>
        <tr>
            <th>Gender</th>
            <td><%= user.gender %></td>
        </tr>
        <tr>
            <th>Hobbies</th>
            <td><%= user.hobbies.join(', ') %></td>
        </tr>
        <tr>
            <th>Profile Picture</th>
            <td>
                <div class="pic-card" style="width: 120px;">
                    <img src="/uploads/<%= user.profilePic %>" alt="Profile Picture" class="thumb">
                    <a href="/download/<%= user.profilePic %>" class="download-btn">Download</a>
                </div>
            </td>
        </tr>
        <tr>
            <th>Other Pictures</th>
            <td>
                <% if (user.otherPics && user.otherPics.length > 0) { %>
                    <div class="gallery">
                        <% user.otherPics.forEach(function(pic) { %>
                            <div class="pic-card">
                                <img src="/uploads/<%= pic %>" alt="Other Pic" class="thumb">
                                <a href="/download/<%= pic %>" class="download-btn">Download</a>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <em>No other pictures uploaded.</em>
                <% } %>
            </td>
        </tr>
    </table>

    <br>
    <a href="/" class="btn-back">&larr; Register Another User</a>

</body>
</html>
